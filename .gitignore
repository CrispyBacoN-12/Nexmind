# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees (superpowers)
/.worktrees/

# local SQLite dev database
dev.db
*.db
*.db-journal
*.db-wal

# generated RL training data (build artifact — regenerated by scripts/rl/build-gold-dataset.ts)
/rl/data/
*.db-shm

# local Claude Code config
/.claude/

# scheduled-scan log
scripts/scan.log

# one-time sqlite->postgres data export (contains full trade/portfolio data)
scripts/sqlite-export.json

# Obsidian workspace state (machine-local, not content)
obsidian-vault/.obsidian/

# Smart Connections plugin store — per-machine embeddings and event logs,
# rebuilt from the notes themselves. Same category as .obsidian/ above: it
# churned ~76 files per session while contributing nothing reviewable.
obsidian-vault/.smart-env/

# graphify local build cache (regenerated; graph.json itself is tracked)
graphify-out/cache/

# graphify rendered output — dated run snapshots, the HTML viewer, and the
# report are all regenerated from graph.json, which stays tracked.
graphify-out/[0-9]*/
graphify-out/graph.html
graphify-out/GRAPH_REPORT.md
graphify-out/.graphify_labels.json

# python bytecode (mt5-bridge)
__pycache__/
graphify-out/.graphify_root

.cache/
