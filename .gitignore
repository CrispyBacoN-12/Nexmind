# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees (superpowers)
/.worktrees/

# local SQLite dev database
dev.db
*.db
*.db-journal
*.db-wal

# generated RL training data (build artifact — regenerated by scripts/rl/build-gold-dataset.ts)
/rl/data/
*.db-shm

# local Claude Code config
/.claude/

# scheduled-scan log
scripts/scan.log

# one-time sqlite->postgres data export (contains full trade/portfolio data)
scripts/sqlite-export.json

# Obsidian workspace state (machine-local, not content)
obsidian-vault/.obsidian/

# Smart Connections plugin store — per-machine embeddings and event logs,
# rebuilt from the notes themselves. Same category as .obsidian/ above: it
# churned ~76 files per session while contributing nothing reviewable.
obsidian-vault/.smart-env/

# graphify output is entirely generated from the vault. graph.json rewrote
# ~115k lines on its second run and manifest.json is a table of per-machine
# mtimes, so neither produces a reviewable diff. Ignore the directory whole.
graphify-out/

# python bytecode (mt5-bridge)
__pycache__/

.cache/

# Personal vault notes that have nothing to do with this repo and should not
# be published with it: medical-school coursework and a Claude skills index.
obsidian-vault/SIID*.md
obsidian-vault/Claude Skills/

# One-off DB backups taken before destructive migrations. Recovery artifacts,
# not source: they hold full trade history and run to tens of MB.
backup-*.json

# scheduled research-round log (same category as scripts/scan.log above)
scripts/research-round.log
