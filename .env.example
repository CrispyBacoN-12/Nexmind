# Anthropic API key — powers HAWK, SAGE, the Secretary, and SCOUT.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# SQLite database (better-sqlite3 driver adapter).
DATABASE_URL=file:./dev.db

# Alpaca market data (optional). When both are set, NEXMIND uses Alpaca's free
# IEX feed for candles/prices and falls back to Yahoo on any error. Leave unset
# to use Yahoo only. Get keys at https://alpaca.markets (paper account is free).
ALPACA_KEY=
ALPACA_SECRET=

# Discord webhook (optional) — trade fill/close, drawdown-threshold, and
# cron-failure notifications. Server Settings > Integrations > Webhooks.
# Leave unset to no-op (messages are just logged to the console instead).
DISCORD_WEBHOOK_URL=

# OANDA v20 practice-account API (optional) — independent spot XAU_USD/forex
# cross-check, since Alpaca has no forex/commodity feed and Yahoo has no
# direct spot-gold ticker. Generate a personal access token from a free
# practice account: My Account > My Services > Manage API Access.
OANDA_API_KEY=

# MT5 bridge (optional, local dev only) — when set, the scanner tries the
# local MT5 terminal (via mt5-bridge/bridge.py) first for XAUUSD/XAGUSD and
# any 6-letter forex symbol, before falling back to Alpaca/Yahoo. Only works
# when the Next.js server and the MT5 terminal run on the same machine.
# MT5_BRIDGE_SECRET must match what bridge.py was started with.
MT5_BRIDGE_SECRET=
MT5_BRIDGE_URL=http://127.0.0.1:8787
# Extra broker-specific tickers to route through MT5 (e.g. suffixed "XAUUSDm").
MT5_SYMBOLS=

# Webull market data (optional, tried before Alpaca when set) + PaperTrade
# shadow execution (optional, opt-in per portfolio via webullShadowEnabled).
# When WEBULL_PAPER_APP_KEY/SECRET are unset, NEXMIND falls back to
# Alpaca/Yahoo exactly as today and shadow mode simply never activates.
#
# IMPORTANT: production and sandbox are separate systems with separately
# issued App Key/Secret pairs — a production key does NOT work against the
# sandbox host and vice versa (confirmed against the live API; sandbox
# rejects a production key with a generic "wrong environment" 401).
#
# Market-data candle fetches (webull.ts) sign against SANDBOX, not
# production, on purpose: production additionally requires a session
# x-access-token minted via POST /openapi/auth/token/create, approved in the
# Webull mobile app, before POST /openapi/auth/token/check reports NORMAL —
# fine for a one-off script (see scripts/webull-account-list.mts) but not for
# an unattended fetch path. Sandbox needs no such approval; verified real
# market data comes back with plain AK/SK signing alone.
#
# Webull publishes shared public App Key/Secret + account-id triples for the
# sandbox environment — no application/approval needed. See "API
# Environments" > "Test Accounts" at developer.webull.co.th/apis/docs/sdk for
# the current shared credentials. These are shared with other developers —
# orders/positions on them may change at any time. For a private, dedicated
# sandbox account, contact Webull developer support directly (no self-serve
# application exists for this as of 2026-08).
WEBULL_PAPER_APP_KEY=
WEBULL_PAPER_APP_SECRET=
WEBULL_PAPER_BASE_URL=https://th-api.uat.webullbroker.com
WEBULL_PAPER_ACCOUNT_ID=

# Production (real Webull account — only needed for PaperTrade shadow-order
# polling / a future live-trading phase, not for market data; not yet wired
# up — see webull/paperTrade.ts). Get keys via developer.webull.co.th >
# avatar menu > Developer Tool > API Management > My Application; ~1-2
# business days for approval, then API Keys Management to generate the key.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_BASE_URL=https://api.webull.co.th
