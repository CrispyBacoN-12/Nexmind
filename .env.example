# Postgres (Neon). The only required variable.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- AI backend (optional; pick one, or neither) -----------------------------
# Backend resolution is: ANTHROPIC_API_KEY -> Claude Code CLI -> deterministic
# mock. With neither set the app still runs; every trade it writes is labelled
# aiBackend="mock" so rule-only decisions are never shown as analysis.

# 1. Pay-per-token SDK access.
ANTHROPIC_API_KEY=

# 2. Subscription auth for runners with no persisted `claude login` session
#    (GitHub Actions). Produce with `claude setup-token`. Injected into the
#    spawned CLI child only — never into this process's env — so resolution
#    still picks the CLI, not the SDK (which would reject this value).
CLAUDE_CODE_OAUTH_TOKEN=

# --- Market data (all optional; Yahoo needs no key and is the last resort) ---

# Webull sandbox — tried FIRST when both are set. Data only: the trading API
# can't be reached unattended, so NEXMIND never places a Webull order.
# Candle fetches sign against the sandbox on purpose; production additionally
# requires a session x-access-token approved in the Webull mobile app, which
# is fine for a one-off script but not for an unattended fetch path.
# Webull publishes shared public sandbox credentials — see "API Environments"
# > "Test Accounts" at developer.webull.co.th/apis/docs/sdk. They are shared
# with other developers and may change at any time.
WEBULL_PAPER_APP_KEY=
WEBULL_PAPER_APP_SECRET=
WEBULL_PAPER_BASE_URL=https://th-api.uat.webullbroker.com

# Webull production pair. Not used by any scheduled path — only the one-off
# scripts/webull-account-list.mts signs with it. Keys via
# developer.webull.co.th > avatar menu > Developer Tool > API Management.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_BASE_URL=https://api.webull.co.th

# Alpaca — tried after Webull. Free paper account at https://alpaca.markets.
# The feed defaults to `sip`; set ALPACA_FEED=iex on a key without SIP
# entitlement and accept the gappier history that comes with it.
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_FEED=

# Finnhub (optional) — company fundamentals and the news digest handed to the
# analysts. Unset simply means those sections of the facts sheet are empty.
FINNHUB_API_KEY=

# --- Ops (optional) ----------------------------------------------------------

# Discord webhook — trade fill/close, drawdown-threshold, and cron-failure
# notifications. Server Settings > Integrations > Webhooks. Unset = console only.
DISCORD_WEBHOOK_URL=

# Bearer token guarding /api/cron/*. Required for those routes to answer at all.
CRON_SECRET=

# Base URL scripts/bot.ts posts to. Defaults to http://localhost:3275.
NEXMIND_URL=
